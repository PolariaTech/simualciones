    await fillByLabel(dialog, /Correo/i, u.email);
    await fillByLabel(dialog, /^Clave$/i, sim.passwordUnica);
    await submitModal(configPage, /Crear/i, true);
    await sleep(1300 + Math.floor(Math.random() * 900));
  }
}

